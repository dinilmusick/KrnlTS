{
  "name": "@ultrst-armada/krnl",
  "version": "1.0.1",
  "private": false,
  "description": "Krnl: Backend Service Framework for Skipo — authoring, executing, and validating modular backend services, facades, and workflows",
  "type": "module",
  "main": "./packages/core/dist/index.js",
  "module": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "files": [
    "packages/*/dist/**",
    "packages/*/package.json"
  ],
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js",
      "require": "./packages/core/dist/index.cjs",
      "default": "./packages/core/dist/index.js"
    },
    "./validate": {
      "types": "./packages/validate/dist/index.d.ts",
      "import": "./packages/validate/dist/index.js",
      "require": "./packages/validate/dist/index.cjs",
      "default": "./packages/validate/dist/index.js"
    },
    "./cli": {
      "types": "./packages/cli/dist/index.d.ts",
      "import": "./packages/cli/dist/index.js",
      "require": "./packages/cli/dist/index.cjs",
      "default": "./packages/cli/dist/index.js"
    }
  },
  "bin": {
    "krnl": "./packages/cli/dist/bin/krnl.js",
    "krnlts-watch": "./packages/cli/dist/bin/krnl.js",
    "krnlts-validate": "./packages/cli/dist/bin/krnl.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "validate": "node packages/cli/dist/bin/krnl.js validate",
    "dev": "node packages/cli/dist/bin/krnl.js dev",
    "watch": "node packages/cli/dist/bin/krnl.js watch"
  },
  "keywords": [
    "krnl",
    "skipo",
    "service-framework",
    "backend",
    "backend-modules",
    "services",
    "service-facades",
    "protocols",
    "workflows",
    "ast-purity"
  ],
  "author": "Dinil Palackal",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.6.0",
    "better-sqlite3": "^13.0.3",
    "protobufjs": "^8.7.1",
    "tsup": "^8.4.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0",
    "ws": "^8.20.0",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  }
}
