{
  "name": "@dinilmusick/krnl",
  "version": "1.0.0",
  "description": "Krnl: Full-Stack Multiplatform Framework with Direct-DOM Reactivity, AST Purity Gates, Code Evolution, and Visual Node IDE",
  "type": "module",
  "main": "packages/core/dist/index.js",
  "types": "packages/core/dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./packages/core/dist/index.js",
      "require": "./packages/core/dist/index.cjs"
    },
    "./ui": {
      "import": "./packages/ui/dist/index.js",
      "require": "./packages/ui/dist/index.cjs"
    },
    "./validate": {
      "import": "./packages/validate/dist/index.js",
      "require": "./packages/validate/dist/index.cjs"
    },
    "./cli": {
      "import": "./packages/cli/dist/index.js",
      "require": "./packages/cli/dist/index.cjs"
    },
    "./studio": {
      "import": "./packages/studio/dist/index.js",
      "require": "./packages/studio/dist/index.cjs"
    }
  },
  "bin": {
    "krnl": "./packages/cli/dist/bin/krnl.js",
    "krnlts-watch": "./packages/cli/dist/bin/krnl.js",
    "krnlts-validate": "./packages/cli/dist/bin/krnl.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "pnpm --filter @dinilmusick/krnl-core run build && pnpm --filter @dinilmusick/krnl-ui run build && pnpm --filter @dinilmusick/krnl-validate run build && pnpm --filter @dinilmusick/eslint-plugin-krnl run build && pnpm --filter @dinilmusick/krnl-studio run build && pnpm --filter @dinilmusick/krnl-cli run build && pnpm --filter create-krnl run build",
    "validate": "node packages/cli/dist/bin/krnl.js validate",
    "dev": "node packages/cli/dist/bin/krnl.js dev",
    "watch": "node packages/cli/dist/bin/krnl.js watch"
  },
  "keywords": [
    "krnl",
    "framework",
    "full-stack",
    "multiplatform",
    "vanjs",
    "code-evolution",
    "visual-ide",
    "node-editor",
    "ast-purity",
    "orchestrator"
  ],
  "author": "Dinil Palackal",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.6.0",
    "better-sqlite3": "^13.0.3",
    "protobufjs": "^8.7.1",
    "tsup": "^8.4.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "ws": "^8.20.0",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  }
}
