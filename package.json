{
  "name": "krnljs",
  "version": "0.1.0",
  "description": "The core library for the Krnl ecosystem, providing a uniform syntax and API across JavaScript projects.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --external ws",
    "sync": "pnpm install"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "krnl",
    "framework",
    "messaging",
    "entities",
    "orchestrator"
  ],
  "author": "Dinil Palackal",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
