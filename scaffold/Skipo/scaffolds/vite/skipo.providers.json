{
  "schemaVersion": 1,
  "application": {
    "entry": "src/app.ts",
    "protocol": "fetch"
  },
  "providers": {
    "cloudflare": {
      "entry": "src/providers/cloudflare.ts",
      "output": "dist/providers/cloudflare/worker.js"
    },
    "vercel": {
      "entry": "src/providers/vercel.ts",
      "output": "api/[...path].js",
      "runtime": "node",
      "additionalOutputs": [
        "api/mcp.js"
      ]
    },
    "node": {
      "entry": "src/providers/node.ts",
      "output": "dist/providers/node/server.js"
    }
  },
  "build": {
    "command": "npm run build"
  }
}
