{
  "name": "aiko",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "skipo": {
    "deploy": "fullstack"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run check:canonical-ui && node scripts/verify-build-boundary.cjs && npm run typecheck && node scripts/skipo-build.cjs",
    "build:fullstack": "npm run build",
    "start": "node api/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist api",
    "lint": "tsc --noEmit",
    "test": "npm run test:google-sdk-boundary && npm run test:integration && npm run test:system-env && npm run test:architecture && npm run test:ecosystem-hardening",
    "test:architecture": "node --test scripts/test-fod-architecture.mjs",
    "build:api": "node scripts/skipo-build.cjs",
    "test:system-env": "node scripts/test-system-database-env.mjs",
    "test:integration": "find src/backend/workflows src/backend/runtime src/backend/apiRoutes src/backend/adapters src/frontend/components/views/WorkflowsView -type f \\( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.spec.ts' -o -name '*.spec.tsx' -o -name '*.test.js' -o -name '*.spec.js' \\) -print 2>/dev/null | xargs -r node --import tsx --test && node scripts/test-canonical-luth-auth.mjs",
    "test:google-sdk-boundary": "node scripts/test-google-sdk-boundary.mjs",
    "test:ecosystem-hardening": "node --test scripts/test-ecosystem-hardening.mjs scripts/test-build-artifact-freshness.mjs",
    "verify:build-artifacts": "node scripts/verify-build-artifacts-freshness.mjs",
    "check:canonical-ui": "node scripts/check-canonical-auth-workspace-ui.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@dinilmusick/gutts": "2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@neondatabase/serverless": "^1.2.0",
    "@ultrst-armada/floks": "2.0.6",
    "@ultrst-armada/frnlts": "0.5.23",
    "@ultrst-armada/kloks": "^2.0.5",
    "@ultrst-armada/krnl": "1.0.25",
    "@xyflow/react": "^12.12.1",
    "cors": "^2.8.6",
    "d3-force": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "force-graph": "^1.51.4",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.57.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-force-graph-2d": "^1.29.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
