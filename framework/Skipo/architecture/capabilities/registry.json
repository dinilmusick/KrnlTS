    "auth": {
      "kind": "capability",
      "description": "Canonical Luth authentication and Floks auth surface.",
      "dependencies": {
        "@ultrst-armada/floks": "^2.0.0",
        "@ultrst-armada/kloks": "^2.0.4"
      },
      "providers": [
        {
          "package": "@ultrst-armada/floks",
          "surface": "auth",
          "symbol": "LuthAuthPage"
        },
        {
          "package": "@ultrst-armada/kloks",
          "surface": "backend",
          "symbol": "AuthServiceFacade"
        }
      ],
      "generated": [
        {
          "path": "src/libraries/skipo/auth.ts",
          "content": "export { LuthAuthPage } from '@ultrst-armada/floks/auth';\nexport { AuthServiceFacade } from '@ultrst-armada/kloks/backend';\n"
        },
        {
          "path": "src/frontend/pages/auth/page.tsx",
          "content": "import { LuthAuthPage } from '@ultrst-armada/floks/auth';\n\nexport default function AuthPage() {\n  return <LuthAuthPage ecosystemId=\"ultrst-armada\" applicationId=\"skipo-app\" appName=\"SKIPO APP\" />;\n}\n"
        }
      ],
      "safeRetire": [
        "src/frontend/components/AuthPage.tsx",
        "src/frontend/components/LoginPage.tsx",
        "src/frontend/auth/AuthPage.tsx"
      ],
      "duplicatePatterns": [
        "\\bPBKDF2\\b",
        "\\bbcrypt\\b",
        "\\bpasswordHash\\b",
        "\\blocalAuthProvider\\b",
        "fetch\\([^\\n]*(?:/api/auth|/login|/signin)"
      ],
      "forbiddenWithoutCanonical": [
        "local auth provider",
        "local password authority",
        "local session authority"
      ],
      "status": "canonical",
      "ownership": {
        "composition": "skipo",
        "implementations": [
          "@ultrst-armada/floks",
          "@ultrst-armada/kloks"
        ]
      },
      "migration": {
        "strategy": "capability-composition",
        "target": "current",
        "from": []
      },
      "repair": {
        "strategy": "recompose-owned-files",
        "idempotent": true,
        "unknownState": "preserve"
      },
      "verification": {
        "strategy": "provider-and-generated-file-integrity",
        "checks": [
          "provider-resolution",
          "generated-file-checksum",
          "dependency-contract"
        ]
      }
    },
