  "registryVersion": "2.0.0",
  "supportedVersions": [
    "2.0.0"
  ],
  "applicationState": {
    "framework": {
      "name": "skipo",
      "version": "1.1.0",
      "owner": "skipo",
      "lifecycle": "canonical"
    },
    "dependencies": {
      "@dinilmusick/gutts": "^2.1.1",
      "@ultrst-armada/krnl": "^1.0.25",
      "@ultrst-armada/frnlts": "^0.5.23",
      "@ultrst-armada/kloks": "^2.0.4",
      "@ultrst-armada/floks": "^2.0.0"
    },
    "ownership": {
      "applicationComposition": "skipo",
      "backendServices": "@ultrst-armada/kloks",
      "uiCapabilities": "@ultrst-armada/floks",
      "backendFoundation": "@ultrst-armada/krnl",
      "frontendFoundation": "@ultrst-armada/frnlts",
      "foundationalLibraries": "@dinilmusick/gutts",
      "authenticationAuthority": "luth"
    },
    "canonicalServices": [
      "midi",
      "storage"
    ],
    "canonicalUiCapabilities": [
      "accounts",
      "canvas",
      "navigation",
      "settings",
      "workspace"
    ],
    "auth": {
      "authority": "luth",
      "capability": "auth",
      "providerPackages": [
        "@ultrst-armada/floks",
        "@ultrst-armada/kloks"
      ]
    },
    "workspaces": {
      "capability": "workspace",
      "uiOwner": "@ultrst-armada/floks",
      "serviceOwner": "@ultrst-armada/kloks",
      "storagePolicyOwner": "@ultrst-armada/kloks"
    },
    "configuration": {
      "projectManifest": ".skipo/project.json",
      "dependencyState": ".skipo/dependencies.json",
      "capabilityState": ".skipo/capabilities.json",
      "overrides": ".skipo/overrides.json",
      "migrationState": ".skipo/migration-state.json"
    },
    "commands": [
      "adopt",
      "inspect",
      "diagnose",
      "plan",
      "add",
      "remove",
      "sync",
      "update",
      "repair",
      "verify",
      "test"
    ],
    "environment": {
      "node": ">=22",
      "packageManager": "pnpm@10.33.0",
      "lockfile": "pnpm-lock.yaml",
      "forbiddenVariables": [
        "SKIPO_DISABLE_CANONICAL_STATE_ENFORCEMENT"
      ]
    },
    "migrations": {
      "registry": "architecture/capabilities/migrations.json",
      "stateFile": ".skipo/migration-state.json",
      "policy": "deterministic-idempotent"
    },
    "deprecated": [],
    "repairRules": [
      {
        "id": "preserve-unknown",
        "when": "unrecognized-or-application-owned-state",
        "strategy": "preserve-and-report",
        "owner": "skipo"
      },
      {
        "id": "recompose-owned",
        "when": "canonical-generated-file-drift",
        "strategy": "recompose-only-skipo-owned-files",
        "owner": "skipo"
      },
      {
        "id": "retire-explicit",
        "when": "registry-declared-safe-retirement",
        "strategy": "retire-only-explicit-safe-paths",
        "owner": "skipo"
      }
    ],
    "constraints": [
      {
        "id": "single-canonical-provider",
        "rule": "canonical implementations remain in their owning provider packages",
        "owner": "skipo"
      },
      {
        "id": "no-downstream-identities",
        "rule": "registry describes framework capabilities and never names downstream applications",
        "owner": "skipo"
      },
      {
        "id": "unknown-state-preserved",
        "rule": "unknown or application-owned state is never destructively repaired",
        "owner": "skipo"
      }
    ],
    "verification": [
      {
        "id": "registry-schema",
        "strategy": "validate-registry-schema-and-version"
      },
      {
        "id": "capability-resolution",
        "strategy": "resolve-every-capability-and-alias"
      },
      {
        "id": "provider-ownership",
        "strategy": "verify-provider-package-ownership"
      },
      {
        "id": "generated-integrity",
        "strategy": "verify-generated-file-checksums"
      },
      {
        "id": "migration-integrity",
        "strategy": "verify-migration-paths-and-state"
      }
    ]
  }
}
