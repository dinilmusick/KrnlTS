{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skipo.dev/schemas/deployment-target.schema.json",
  "title": "Skipo Deployment Target Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "application",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "application": {
      "type": "object",
      "required": [
        "name",
        "rootDirectory"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rootDirectory": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "buildCommand"
        ],
        "properties": {
          "provider": {
            "enum": [
              "vercel",
              "cloudflare"
            ]
          },
          "buildCommand": {
            "type": "string",
            "minLength": 1
          },
          "configFile": {
            "type": "string"
          },
          "rootDirectory": {
            "type": "string"
          },
          "runtime": {
            "enum": [
              "nodejs",
              "edge",
              "workers",
              "pages",
              "static"
            ]
          },
          "environment": {
            "enum": [
              "preview",
              "production"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}