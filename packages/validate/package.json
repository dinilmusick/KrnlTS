{
  "name": "@dinilmusick/krnl-validate",
  "version": "1.0.1",
  "description": "Deep AST validation and 4-layer function purity engine for Krnl backend services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --external ts-morph"
  },
  "dependencies": {
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
