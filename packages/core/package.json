{
  "name": "@ultrst-armada/krnl-core",
  "version": "1.0.2",
  "description": "Core runtime engine, Service facades, Protocols, Transports, and Execution flows for Krnl backend services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "p-queue": "^10.0.0",
    "protobufjs": "^8.7.1",
    "ws": "^8.18.0",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "protobufjs-cli": "^2.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0"
  },
  "module": "dist/index.js"
}
