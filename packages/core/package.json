{
  "name": "@dinilmusick/krnl-core",
  "version": "1.0.1",
  "description": "Core runtime engine, Service facades, Protocols, Transports, and Execution flows for Krnl backend services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --external ws,zod,zod-to-json-schema,esbuild"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "protobufjs": "^8.7.1",
    "ws": "^8.18.0",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "protobufjs-cli": "^2.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
