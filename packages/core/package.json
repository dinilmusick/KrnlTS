{
  "name": "@ultrst-armada/krnl-core",
  "version": "1.1.0",
  "description": "Core runtime engine, Service facades, Protocols, Transports, and Execution flows for Krnl backend services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "default": "./dist/node.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs",
      "default": "./dist/fetch.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dinilmusick/gutts": "^2.0.3",
    "p-queue": "^10.0.0",
    "protobufjs": "^8.7.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "protobufjs-cli": "^2.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0"
  },
  "module": "dist/index.js",
  "peerDependencies": {
    "@types/node": ">=20.0.0",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
