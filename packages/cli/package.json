{
  "name": "@dinilmusick/krnl-cli",
  "version": "1.0.0",
  "description": "Unified CLI for the Krnl Framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "krnl": "dist/bin/krnl.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@dinilmusick/krnl-core": "workspace:*",
    "@dinilmusick/krnl-studio": "workspace:*",
    "@dinilmusick/krnl-validate": "workspace:*",
    "ts-morph": "^25.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
